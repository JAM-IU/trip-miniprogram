/* 全局样式 v5 - 双主题（白天默认 / 夜间） */
page {
  /* ===== 白天主题（默认）===== */
  --bg: linear-gradient(180deg, #F0F3F8 0%, #E7EBF2 100%);
  --card: rgba(255, 255, 255, 0.9);
  --card-solid: #FFFFFF;
  --card-border: rgba(20, 26, 41, 0.06);
  --card-shadow: 0 8rpx 28rpx rgba(31, 41, 55, 0.08);
  --text: #1F2430;
  --sub: #8993A6;
  --weak: #B7BECB;
  --primary: #4F8CFF;
  --primary-deep: #3E75E8;
  --primary-soft: rgba(79, 140, 255, 0.10);
  --gold: #F5A623;
  --gold-deep: #DF9400;
  --gold-soft: rgba(245, 166, 35, 0.12);
  --green: #22C07A;
  --green-soft: #E4F6ED;
  --red: #FF5A52;
  --red-soft: #FFEEED;
  --red-deep: #E8433B;
  --divider: rgba(20, 26, 41, 0.06);
  --sheet: #FFFFFF;
  --mask: rgba(15, 20, 32, 0.5);

  background: #EDEFF5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
}

/* ===== 夜间主题 ===== */
.theme-dark {
  --bg: radial-gradient(120% 80% at 80% -10%, #1B2640 0%, #0F1420 45%, #0A0E18 100%);
  --card: rgba(255, 255, 255, 0.06);
  --card-solid: rgba(24, 30, 46, 0.96);
  --card-border: rgba(255, 255, 255, 0.08);
  --card-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
  --text: #E8ECF3;
  --sub: #8A93A6;
  --weak: #4A5162;
  --primary: #75B7FF;
  --primary-deep: #4A7FD0;
  --primary-soft: rgba(117, 183, 255, 0.15);
  --gold: #F5C46A;
  --gold-deep: #E0A94A;
  --gold-soft: rgba(245, 196, 106, 0.14);
  --green: #6AE09C;
  --green-soft: rgba(106, 224, 156, 0.14);
  --red: #FF8A80;
  --red-soft: rgba(255, 138, 128, 0.14);
  --red-deep: #E05A4E;
  --divider: rgba(255, 255, 255, 0.07);
  --sheet: rgba(24, 30, 46, 0.96);
  --mask: rgba(0, 0, 0, 0.6);
}

/* ===== 通用底部弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: var(--mask);
  z-index: 100;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: var(--sheet);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.18);
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 36rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  animation: slideUp 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 弹窗顶部抓手 */
.sheet::before {
  content: '';
  display: block;
  width: 72rpx;
  height: 8rpx;
  background: var(--weak);
  border-radius: 99rpx;
  margin: 18rpx auto 12rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
  color: var(--text);
}

/* ===== 通用表单 ===== */
.frow {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.frow:last-of-type {
  border-bottom: none;
}

.frow.fcol {
  flex-direction: column;
  align-items: flex-start;
}

.flabel {
  width: 170rpx;
  font-size: 28rpx;
  color: var(--sub);
  flex-shrink: 0;
}

.finput {
  flex: 1;
  font-size: 32rpx;
  min-width: 0;
  color: var(--text);
  font-weight: 500;
}

.ftext {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  margin-top: 12rpx;
  line-height: 1.6;
  color: var(--text);
}

.fpick {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 600;
}

.ph {
  color: var(--weak);
}

/* ===== 通用按钮 ===== */
.btns {
  display: flex;
  gap: 24rpx;
  margin-top: 44rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 20rpx;
  font-size: 32rpx;
  transition: all 0.15s;
}

.btn:active {
  opacity: 0.75;
  transform: scale(0.98);
}

.btn-save {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(62, 117, 232, 0.3);
}

.btn-del {
  background: var(--red-soft);
  color: var(--red);
  font-weight: 600;
}

/* ===== 通用状态 ===== */
.loading-box {
  text-align: center;
  color: var(--sub);
  font-size: 26rpx;
  padding: 80rpx 0;
}

.empty-box {
  text-align: center;
  color: var(--sub);
  padding: 120rpx 40rpx;
  font-size: 28rpx;
  line-height: 2;
}

.empty-box view:first-child {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

/* ===== 动效增强 ===== */
/* 页面整体入场（只用 opacity，不能用 transform，否则会把 fixed 元素锚定出位） */
.page {
  animation: pageIn 0.42s ease both;
}

@keyframes pageIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 列表项逐个入场（delay 由内联 animation-delay 控制） */
.anim-in {
  animation: listIn 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes listIn {
  from { opacity: 0; transform: translateY(26rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 强调块弹入 */
.anim-pop {
  animation: popIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes popIn {
  0% { opacity: 0; transform: scale(0.92); }
  60% { opacity: 1; transform: scale(1.02); }
  100% { opacity: 1; transform: scale(1); }
}

/* 主按钮光晕脉冲 */
.btn-save, .add-btn, .big-add, .mem-add {
  animation: glowPulse 2.6s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { box-shadow: 0 12rpx 36rpx rgba(62, 117, 232, 0.3); }
  50% { box-shadow: 0 12rpx 48rpx rgba(62, 117, 232, 0.5); }
}