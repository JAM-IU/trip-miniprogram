/* 全局样式 */
page {
  background: #EDEDF2;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* ===== 通用底部弹窗 ===== */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

/* ===== 通用表单 ===== */
.frow {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2F2F5;
}

.frow.fcol {
  flex-direction: column;
  align-items: flex-start;
}

.flabel {
  width: 160rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.finput {
  flex: 1;
  font-size: 30rpx;
  min-width: 0;
}

.ftext {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
}

.fpick {
  font-size: 30rpx;
  color: #2E5A88;
  font-weight: 500;
}

.ph {
  color: #BBB;
}

/* ===== 通用按钮 ===== */
.btns {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-save {
  background: #2E5A88;
  color: #fff;
  font-weight: 600;
}

.btn-del {
  background: #FDECEA;
  color: #D63031;
}

/* ===== 通用状态 ===== */
.loading-box {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 60rpx 0;
}

.empty-box {
  text-align: center;
  color: #999;
  padding: 80rpx 40rpx;
  font-size: 26rpx;
}
