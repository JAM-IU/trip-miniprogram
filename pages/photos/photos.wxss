/* 照片墙占位页 */
.page {
  min-height: 100vh;
  background: var(--bg);
  padding: 32rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ===== 头部 ===== */
.ph-hero {
  position: relative;
  text-align: center;
  padding: 72rpx 40rpx 64rpx;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 40rpx;
  box-shadow: var(--card-shadow);
  overflow: hidden;
}

/* 装饰光圈 */
.ph-hero::before {
  content: '';
  position: absolute;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--primary-soft) 0%, transparent 70%);
  top: -140rpx;
  right: -100rpx;
}

.ph-hero::after {
  content: '';
  position: absolute;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: radial-gradient(circle, var(--gold-soft) 0%, transparent 70%);
  bottom: -110rpx;
  left: -80rpx;
}

.ph-hero-deco {
  font-size: 88rpx;
  margin-bottom: 16rpx;
  position: relative;
  z-index: 1;
}

.ph-hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--text);
  letter-spacing: 2rpx;
  position: relative;
  z-index: 1;
}

.ph-hero-badge {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 32rpx;
  border-radius: 99rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--gold-deep);
  background: var(--gold-soft);
  border: 1rpx solid var(--gold);
  letter-spacing: 4rpx;
  position: relative;
  z-index: 1;
}

.ph-hero-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--sub);
  position: relative;
  z-index: 1;
}

/* ===== 占位照片墙 ===== */
.ph-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
}

.ph-cell {
  width: calc((100% - 40rpx) / 3);
  aspect-ratio: 3 / 4;
  border-radius: 24rpx;
  border: 2rpx dashed var(--weak);
  background: var(--card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.ph-cell-icon {
  font-size: 56rpx;
  opacity: 0.75;
}

.ph-cell-label {
  font-size: 22rpx;
  color: var(--sub);
  letter-spacing: 1rpx;
}

/* ===== 功能预告卡 ===== */
.ph-card {
  margin-top: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 40rpx;
  box-shadow: var(--card-shadow);
  padding: 32rpx 32rpx 12rpx;
}

.ph-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.ph-feat {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.ph-feat:last-child {
  border-bottom: none;
}

.ph-feat-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: var(--primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  flex-shrink: 0;
}

.ph-feat-body {
  flex: 1;
  min-width: 0;
}

.ph-feat-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
}

.ph-feat-desc {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 4rpx;
}

/* ===== 底部 ===== */
.ph-foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--weak);
  letter-spacing: 1rpx;
}
