<view class="page {{theme === 'dark' ? 'theme-dark' : ''}}">

  <view wx:if="{{loading}}" class="loading-box">计算中…</view>

  <view wx:if="{{!loading && !hasMembers}}" class="empty-box">
    <view>👥 还没有成员</view>
    <view>请先到「记账」页点右上角「成员」添加同行的人</view>
  </view>

  <block wx:if="{{!loading && hasMembers}}">
    <!-- 总览 -->
    <view class="overview anim-pop">
      <view class="ov-deco">🧾</view>
      <view class="ov-num">¥{{totalAmount}}</view>
      <view class="ov-label">总共消费 · {{count}} 笔 · {{stats.length}} 人</view>
    </view>

    <!-- 每人明细 -->
    <view class="section-title">📋 每人明细</view>
    <view class="stat-card anim-in" wx:for="{{stats}}" wx:key="name"
          style="animation-delay: {{index * 70}}ms">
      <image wx:if="{{item.avatar}}" class="stat-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
      <view wx:else class="stat-avatar {{item.isPos ? 'av-pos' : (item.isZero ? 'av-zero' : 'av-neg')}}">{{item.name[0]}}</view>
      <view class="stat-body">
        <view class="stat-name">{{item.name}}</view>
        <view class="stat-detail">垫付 ¥{{item.paid}} · 消费 ¥{{item.owe}}</view>
      </view>
      <view class="stat-net {{item.isPos ? 'pos' : (item.isZero ? 'zero' : 'neg')}}">{{item.netLabel}}</view>
    </view>

    <!-- 转账方案 -->
    <view class="section-title" wx:if="{{transfers.length}}">💸 最简转账方案</view>
    <view class="transfer-card anim-in" wx:if="{{transfers.length}}" style="animation-delay: 160ms">
      <view class="tr-row" wx:for="{{transfers}}" wx:key="index">
        <view class="tr-who-box">
          <text class="tr-from">{{item.from}}</text>
          <text class="tr-arrow">→</text>
          <text class="tr-to">{{item.to}}</text>
        </view>
        <text class="tr-amount">¥{{item.amount}}</text>
      </view>
    </view>

    <view class="ok-card anim-pop" wx:if="{{!transfers.length}}">
      ✅ 人人账目已平，不用互相转账
    </view>

    <view class="copy-btn" bindtap="onCopySettle">📋 复制结算文案发群里</view>

    <view class="foot-tip">大家都在「记账」页记完账，这里的结算自动更新</view>
  </block>

  <!-- 外观设置 -->
  <view class="section-title">🎨 外观</view>
  <view class="mode-card">
    <view class="mode-btn {{themeMode === 'auto' ? 'mode-on' : ''}}"
          bindtap="onThemeMode" data-mode="auto">跟随系统</view>
    <view class="mode-btn {{themeMode === 'light' ? 'mode-on' : ''}}"
          bindtap="onThemeMode" data-mode="light">☀️ 白天</view>
    <view class="mode-btn {{themeMode === 'dark' ? 'mode-on' : ''}}"
          bindtap="onThemeMode" data-mode="dark">🌙 夜间</view>
  </view>
  <view class="foot-tip" style="margin-top: 16rpx;">默认跟随手机系统的深浅色模式</view>

</view>
