.page {
  padding: 24rpx 24rpx 200rpx;
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 总览 ===== */
.overview {
  background: var(--card);
  border: 1rpx solid var(--card-border);
  color: var(--text);
  border-radius: 32rpx;
  padding: 52rpx 24rpx 48rpx;
  margin-bottom: 16rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: var(--card-shadow);
}

/* 装饰圆 */
.overview::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: var(--gold-soft);
}

.overview::after {
  content: '';
  position: absolute;
  bottom: -70rpx;
  left: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: var(--divider);
}

.ov-deco {
  font-size: 48rpx;
  margin-bottom: 8rpx;
  position: relative;
  z-index: 1;
}

.ov-num {
  font-size: 76rpx;
  font-weight: 700;
  line-height: 1.3;
  position: relative;
  z-index: 1;
  color: var(--gold);
}

.ov-label {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 8rpx 20rpx;
  color: var(--text);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* ===== 每人明细 ===== */
.stat-card {
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--card-shadow);
  transition: all 0.15s;
}

.stat-card:active {
  opacity: 0.88;
  transform: scale(0.99);
}

.stat-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.stat-avatar-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--card-border);
}

.av-pos {
  background: linear-gradient(135deg, #4AE08C, #2BB567);
  box-shadow: 0 4rpx 16rpx rgba(43, 181, 103, 0.35);
}

.av-zero {
  background: linear-gradient(135deg, #6B7280, #4A5162);
  box-shadow: 0 4rpx 16rpx rgba(74, 81, 98, 0.3);
}

.av-neg {
  background: linear-gradient(135deg, #FF8A80, #E05A4E);
  box-shadow: 0 4rpx 16rpx rgba(224, 90, 78, 0.35);
}

.stat-body {
  flex: 1;
  min-width: 0;
}

.stat-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.stat-detail {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 4rpx;
}

.stat-net {
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
  text-align: right;
}

.stat-net.pos {
  color: var(--green);
}

.stat-net.neg {
  color: var(--red);
}

.stat-net.zero {
  color: var(--sub);
  font-size: 26rpx;
}

/* ===== 转账方案 ===== */
.transfer-card {
  background: var(--gold-soft);
  border: 1rpx solid var(--divider);
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: var(--card-shadow);
}

.tr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx dashed var(--divider);
}

.tr-row:last-child {
  border-bottom: none;
}

.tr-who-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 30rpx;
}

.tr-from {
  font-weight: 700;
  color: var(--red);
}

.tr-arrow {
  color: var(--gold);
  font-size: 32rpx;
}

.tr-to {
  font-weight: 700;
  color: var(--green);
}

.tr-amount {
  color: var(--gold);
  font-weight: 700;
  font-size: 36rpx;
}

/* ===== 已结清 ===== */
.ok-card {
  background: var(--green-soft);
  border: 1rpx solid var(--divider);
  color: var(--green);
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: var(--card-shadow);
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 40rpx;
  line-height: 1.6;
}

/* ===== 复制结算文案 ===== */
.copy-btn {
  margin-top: 32rpx;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 99rpx;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 10rpx 28rpx rgba(62, 117, 232, 0.3);
  transition: all 0.15s;
}

.copy-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ===== 外观设置 ===== */
.mode-card {
  display: flex;
  gap: 16rpx;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 24rpx;
  padding: 16rpx;
  box-shadow: var(--card-shadow);
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--sub);
  font-weight: 500;
  transition: all 0.15s;
}

.mode-btn:active {
  opacity: 0.75;
}

.mode-btn.mode-on {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(62, 117, 232, 0.28);
}