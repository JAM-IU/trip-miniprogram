.page {
  padding: 24rpx 24rpx 60rpx;
}

/* 总览 */
.overview {
  background: linear-gradient(150deg, #274060, #3A6EA5);
  color: #fff;
  border-radius: 24rpx;
  padding: 44rpx 20rpx;
  margin-bottom: 12rpx;
  text-align: center;
}
.ov-num {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.3;
}
.ov-label {
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 6rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 28rpx 8rpx 16rpx;
}

/* 每人明细 */
.stat-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.stat-name {
  font-size: 32rpx;
  font-weight: 600;
  width: 150rpx;
  flex-shrink: 0;
}
.stat-detail {
  flex: 1;
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}
.stat-net {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.stat-net.pos { color: #1E8E4E; }
.stat-net.neg { color: #D63031; }
.stat-net.zero { color: #999; font-size: 24rpx; }

/* 转账方案 */
.transfer-card {
  background: #FFF8E5;
  border-radius: 20rpx;
  padding: 16rpx 28rpx;
}
.tr-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx dashed #F0DFA0;
}
.tr-row:last-child {
  border-bottom: none;
}
.tr-who {
  font-weight: 500;
}
.tr-amount {
  color: #D63031;
  font-weight: 700;
}

.ok-card {
  background: #E6F6EC;
  color: #1E8E4E;
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 32rpx;
}
