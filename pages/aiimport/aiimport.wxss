.page {
  padding: 24rpx 24rpx calc(60rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 顶部说明 ===== */
.ai-hero {
  background: linear-gradient(135deg, #4F8CFF 0%, #7B5CFF 100%);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(79, 140, 255, 0.35);
  position: relative;
  overflow: hidden;
}

.ai-hero::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.ai-hero-deco {
  font-size: 52rpx;
  margin-bottom: 6rpx;
}

.ai-hero-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.ai-hero-sub {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}

/* ===== 输入卡片 ===== */
.ta-card {
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  padding: 24rpx 24rpx 16rpx;
  margin-bottom: 28rpx;
}

.ta {
  width: 100%;
  min-height: 360rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text);
  box-sizing: border-box;
}

.ph {
  color: var(--weak);
}

.ta-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--divider);
}

.ta-count {
  font-size: 22rpx;
  color: var(--weak);
}

.paste-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding: 10rpx 24rpx;
  background: var(--primary-soft);
  border-radius: 99rpx;
}

.paste-btn:active {
  opacity: 0.7;
}

/* ===== 解析按钮 ===== */
.go-btn {
  text-align: center;
  padding: 28rpx 0;
  border-radius: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  box-shadow: 0 12rpx 36rpx rgba(62, 117, 232, 0.3);
  animation: glowPulse 2.6s ease-in-out infinite;
}

.go-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.go-btn-busy {
  animation: none;
  opacity: 0.7;
}

.safe-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--weak);
  margin-top: 20rpx;
}

/* ===== 预览 ===== */
.pv-head {
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.pv-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.pv-sub {
  font-size: 24rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

.pv-day {
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 28rpx;
  box-shadow: var(--card-shadow);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.pv-day-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding-bottom: 16rpx;
  margin-bottom: 8rpx;
  border-bottom: 1rpx solid var(--divider);
}

.pv-day-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.pv-day-date {
  font-size: 24rpx;
  color: var(--sub);
}

.pv-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.pv-item:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.pv-line1 {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.pv-time {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  background: var(--primary-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.pv-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.pv-fee {
  font-size: 22rpx;
  color: var(--gold-deep);
  background: var(--gold-soft);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
}

.pv-fee-free {
  color: var(--green);
  background: var(--green-soft);
}

.pv-desc {
  font-size: 26rpx;
  color: var(--sub);
  margin-top: 8rpx;
  line-height: 1.5;
}

.pv-ops {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 14rpx;
}

.pv-daymove {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: var(--primary-soft);
  border-radius: 99rpx;
  padding: 6rpx 16rpx;
}

.pv-mv {
  font-size: 24rpx;
  color: var(--primary);
  padding: 4rpx 8rpx;
}

.pv-mvday {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
  min-width: 56rpx;
  text-align: center;
}

.pv-level {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 22rpx;
  border-radius: 99rpx;
}

.lv-must {
  color: var(--red-deep);
  background: var(--red-soft);
}

.lv-rec {
  color: var(--primary-deep);
  background: var(--primary-soft);
}

.lv-opt {
  color: var(--sub);
  background: var(--divider);
}

.pv-del {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--red);
  padding: 8rpx 16rpx;
}

.pv-mv:active, .pv-level:active, .pv-del:active {
  opacity: 0.6;
}

/* ===== 预览空态 / 操作栏 ===== */
.pv-empty {
  text-align: center;
  color: var(--sub);
  font-size: 28rpx;
  padding: 100rpx 0;
  line-height: 2;
}

.pv-empty-emoji {
  font-size: 64rpx;
}

.pv-empty-btn {
  display: inline-block;
  color: var(--primary);
  font-weight: 600;
  margin-top: 12rpx;
  padding: 12rpx 40rpx;
  background: var(--primary-soft);
  border-radius: 99rpx;
}

.pv-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
  padding-bottom: 20rpx;
}

.pva-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 20rpx;
  font-size: 32rpx;
  transition: all 0.15s;
}

.pva-btn:active {
  opacity: 0.75;
  transform: scale(0.98);
}

.pva-ghost {
  background: var(--card);
  border: 1rpx solid var(--card-border);
  color: var(--sub);
  font-weight: 600;
}

.pva-main {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(62, 117, 232, 0.3);
}

.pva-busy {
  opacity: 0.7;
}
