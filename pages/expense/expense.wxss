.page {
  padding: 24rpx 24rpx 320rpx;
  min-height: 100vh;
  background: var(--bg);
  box-sizing: border-box;
}

/* ===== 顶部统计条 ===== */
.topbar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.total-box {
  flex: 1;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  box-shadow: var(--card-shadow);
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
}

.total-icon {
  font-size: 48rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.total-info {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.total-num {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--gold);
  display: block;
  line-height: 1.3;
}

.total-label {
  font-size: 24rpx;
  color: var(--sub);
}

.member-btn {
  width: 150rpx;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-shadow: var(--card-shadow);
  position: relative;
  overflow: hidden;
}

.member-btn:active {
  opacity: 0.75;
  transform: scale(0.98);
}

.member-ico {
  font-size: 40rpx;
  position: relative;
  z-index: 1;
}

.member-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text);
  position: relative;
  z-index: 1;
}

/* ===== 账单列表 ===== */
.exp-item {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--card-border);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--card-shadow);
  transition: all 0.15s;
}

.exp-item:active {
  opacity: 0.85;
  transform: scale(0.99);
}

.exp-date {
  background: var(--green-soft);
  border: 1rpx solid var(--divider);
  color: var(--green);
  font-size: 22rpx;
  font-weight: 700;
  padding: 12rpx 18rpx;
  border-radius: 14rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  letter-spacing: 0.5rpx;
  min-width: 64rpx;
  text-align: center;
}

.exp-body {
  flex: 1;
  min-width: 0;
}

.exp-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}

.exp-meta {
  font-size: 22rpx;
  color: var(--sub);
  margin-top: 6rpx;
}

.exp-payer {
  color: var(--gold);
  font-weight: 600;
}

.exp-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--red);
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ===== 右下角圆形记账按钮（下滑自动收起）===== */
.add-btn {
  position: fixed;
  right: 28rpx;
  bottom: calc(196rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 12rpx 36rpx rgba(62, 117, 232, 0.32);
  z-index: 10;
  transition: transform 0.28s ease, opacity 0.28s ease;
}

.add-btn:active {
  opacity: 0.85;
}

.add-btn.fab-hide {
  transform: translateY(calc(100% + 240rpx));
  opacity: 0;
  pointer-events: none;
}

/* ===== 参与人多选 ===== */
.cb-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  margin-top: 16rpx;
}

.cb {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--divider);
  padding: 16rpx 32rpx;
  border-radius: 99rpx;
  font-size: 28rpx;
  color: var(--sub);
  transition: all 0.15s;
  font-weight: 500;
  border: 1rpx solid transparent;
}

.cb:active {
  opacity: 0.75;
}

.cb-on {
  background: var(--primary-soft);
  border: 1rpx solid rgba(79, 140, 255, 0.3);
  color: var(--primary);
  font-weight: 700;
}

.theme-dark .cb-on {
  border-color: rgba(117, 183, 255, 0.35);
}

/* ===== 成员管理 ===== */
.mem-tip {
  font-size: 24rpx;
  color: var(--sub);
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.mem-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}

.mem-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(62, 117, 232, 0.25);
}

.mem-avatar-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1rpx solid var(--card-border);
}

.mem-name-text {
  flex: 1;
  font-size: 32rpx;
  color: var(--text);
  font-weight: 500;
}

.mem-del {
  color: var(--red);
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  background: var(--red-soft);
  border-radius: 99rpx;
}

.mem-del:active {
  opacity: 0.7;
}

.mem-add {
  background: linear-gradient(135deg, var(--primary), var(--primary-deep));
  color: #fff;
  padding: 14rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 16rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(62, 117, 232, 0.25);
}

.mem-add:active {
  opacity: 0.75;
  transform: scale(0.98);
}

/* 头像选择按钮 */
.avatar-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 16rpx 0 0;
  background: var(--card);
  border: 1rpx dashed var(--weak);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn-ph {
  font-size: 40rpx;
  color: var(--weak);
  line-height: 1;
}

.avatar-btn-img {
  width: 100%;
  height: 100%;
}

/* ===== 微信一键加入 ===== */
.join-box {
  background: var(--primary-soft);
  border: 1rpx solid rgba(79, 140, 255, 0.25);
  border-radius: 20rpx;
  padding: 20rpx 24rpx 24rpx;
  margin-bottom: 20rpx;
}

.join-tip {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.join-done {
  background: var(--green-soft);
  border: 1rpx solid var(--divider);
  color: var(--green);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.mem-me {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #4AE08C, #2BB567);
  border-radius: 99rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}