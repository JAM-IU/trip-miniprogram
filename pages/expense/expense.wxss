.page {
  padding: 24rpx 24rpx 180rpx;
}

/* 顶部统计条 */
.topbar {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.total-box {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.total-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #D63031;
  display: block;
  line-height: 1.3;
}
.total-label {
  font-size: 24rpx;
  color: #999;
}
.member-btn {
  width: 180rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 26rpx;
  color: #555;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.member-ico {
  font-size: 40rpx;
}

/* 账单列表 */
.exp-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.exp-date {
  background: #E7F0FA;
  color: #2E6FB7;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.exp-body {
  flex: 1;
  min-width: 0;
}
.exp-title {
  font-size: 30rpx;
  font-weight: 600;
}
.exp-meta {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.exp-amount {
  font-size: 32rpx;
  font-weight: 700;
  color: #D63031;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 底部按钮 */
.add-btn {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 40rpx;
  background: #D63031;
  color: #fff;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 99rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(214, 48, 49, 0.35);
  z-index: 10;
}

/* 参与人多选 */
.cb-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  margin-top: 12rpx;
}
.cb {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F7F8FA;
  padding: 12rpx 28rpx;
  border-radius: 99rpx;
  font-size: 26rpx;
}
.cb-on {
  background: #E7F0FA;
  color: #2E6FB7;
  font-weight: 600;
}

/* 成员管理 */
.mem-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  line-height: 1.6;
}
.mem-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F2F2F5;
  font-size: 30rpx;
}
.mem-del {
  color: #D63031;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
}
.mem-add {
  background: #2E5A88;
  color: #fff;
  padding: 12rpx 36rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}
